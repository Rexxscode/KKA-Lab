APP_NAME="KKALAB"
APP_ENV=local
APP_KEY=
# WAJIB false di produksi: true membocorkan stack trace/SQL/env ke publik.
APP_DEBUG=true
APP_URL=http://localhost

# Email super-admin (penandatangan sertifikat + satu-satunya yang boleh
# membuat akun admin baru). Recovery: db:seed mengembalikan akun ini.
# SUPER_ADMIN_EMAIL=admin@kkalab.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kka_lab
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Produksi HTTPS: SESSION_SECURE_COOKIE=true agar cookie tak terkirim via HTTP.
# SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Verifikasi email BELUM diwajibkan (User sudah MustVerifyEmail, middleware
# 'verified' sengaja belum dipasang). Nyalakan hanya setelah MAIL_* SMTP asli
# terisi, kalau tidak pengguna baru terkunci tak bisa masuk.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# KKA Lab — Asisten AI (Google AI Studio / Gemini)
# Ambil STANDARD key (diawali AIza) di https://aistudio.google.com/app/apikey lalu isi ke .env
# Key Auth baru diawali AQ. DITOLAK oleh gateway x-goog-api-key — wajib pakai Standard key.
# JANGAN PERNAH isi key asli di file ini (ter-publish ke GitHub)!
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Proteksi key gratisan (disarankan untuk produksi VPS):
# - AI_CHAT_ENABLED=false untuk mematikan chatbot darurat tanpa deploy ulang.
# - AI_GLOBAL_HARIAN=batas total request AI per hari seluruh user (default 500).
# - AI_COOLDOWN_DETIK=jeda antar chat per user (default 10).
# - AI_CACHE_MENIT=cache jawaban identik agar hemat kuota Google (default 60, 0=mati).
AI_CHAT_ENABLED=true
AI_GLOBAL_HARIAN=500
AI_COOLDOWN_DETIK=10
AI_CACHE_MENIT=60
