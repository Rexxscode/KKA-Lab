{
  "meta": {
    "brand": "KKA Lab",
    "palette": "orange/emerald",
    "layers": ["primitive", "semantic", "component"],
    "dark": {
      "page": "#0f172a",
      "surface": "#1e293b",
      "border": "#334155",
      "muted": "#94a3b8",
      "ink": "#f1f5f9",
      "ink-soft": "#cbd5e1",
      "skeleton": "#334155"
    }
  },
  "primitive": {
    "color": {
      "orange": {
        "50": { "$value": "#fff7ed" },
        "100": { "$value": "#ffedd5" },
        "200": { "$value": "#fed7aa" },
        "500": { "$value": "#f97316" },
        "600": { "$value": "#ea580c" },
        "700": { "$value": "#c2410c" }
      },
      "emerald": {
        "50": { "$value": "#ecfdf5" },
        "100": { "$value": "#d1fae5" },
        "200": { "$value": "#a7f3d0" },
        "500": { "$value": "#10b981" },
        "600": { "$value": "#059669" },
        "700": { "$value": "#047857" },
        "800": { "$value": "#065f46" }
      },
      "slate": {
        "100": { "$value": "#f1f5f9" },
        "200": { "$value": "#e2e8f0" },
        "500": { "$value": "#64748b" },
        "700": { "$value": "#334155" },
        "800": { "$value": "#1e293b" },
        "900": { "$value": "#0f172a" }
      },
      "white": { "$value": "#ffffff" },
      "page": { "$value": "#fafafa" }
    },
    "radius": {
      "md": { "$value": "0.75rem" },
      "lg": { "$value": "1rem" },
      "pill": { "$value": "9999px" }
    },
    "font": {
      "sans": { "$value": "\"Plus Jakarta Sans\", \"Figtree\", \"Inter\", ui-sans-serif, system-ui, sans-serif" }
    },
    "motion": {
      "fast": { "$value": "150ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "300ms" }
    },
    "shadow": {
      "sm": { "$value": "0 1px 2px rgb(15 23 42 / 0.05)" },
      "lg": { "$value": "0 10px 15px -3px rgb(15 23 42 / 0.1)" }
    }
  },
  "semantic": {
    "color": {
      "primary": { "$value": "{primitive.color.orange.500}" },
      "primary-strong": { "$value": "{primitive.color.orange.600}" },
      "primary-ink": { "$value": "{primitive.color.orange.700}" },
      "primary-tint": { "$value": "{primitive.color.orange.50}" },
      "primary-border": { "$value": "{primitive.color.orange.200}" },
      "success": { "$value": "{primitive.color.emerald.500}" },
      "success-strong": { "$value": "{primitive.color.emerald.600}" },
      "success-ink": { "$value": "{primitive.color.emerald.700}" },
      "success-deep": { "$value": "{primitive.color.emerald.800}" },
      "success-tint": { "$value": "{primitive.color.emerald.50}" },
      "success-border": { "$value": "{primitive.color.emerald.200}" },
      "page": { "$value": "{primitive.color.page}" },
      "surface": { "$value": "{primitive.color.white}" },
      "border": { "$value": "{primitive.color.slate.200}" },
      "muted": { "$value": "{primitive.color.slate.500}" },
      "ink": { "$value": "{primitive.color.slate.900}" },
      "ink-soft": { "$value": "{primitive.color.slate.700}" },
      "focus": { "$value": "{primitive.color.orange.500}" }
    },
    "radius": {
      "card": { "$value": "{primitive.radius.lg}" },
      "input": { "$value": "{primitive.radius.md}" },
      "badge": { "$value": "{primitive.radius.pill}" }
    },
    "font": {
      "sans": { "$value": "{primitive.font.sans}" },
      "size-display": { "$value": "2.25rem" }
    },
    "motion": {
      "fast": { "$value": "{primitive.motion.fast}" },
      "base": { "$value": "{primitive.motion.base}" }
    },
    "shadow": {
      "card": { "$value": "{primitive.shadow.sm}" }
    }
  },
  "component": {
    "btn": {
      "primary-bg": { "$value": "{semantic.color.primary}" },
      "primary-bg-hover": { "$value": "{semantic.color.primary-strong}" },
      "primary-fg": { "$value": "{primitive.color.white}" }
    },
    "card": {
      "bg": { "$value": "{semantic.color.surface}" },
      "border": { "$value": "{semantic.color.border}" },
      "radius": { "$value": "{semantic.radius.card}" }
    },
    "badge": {
      "bg": { "$value": "{semantic.color.success-tint}" },
      "fg": { "$value": "{semantic.color.success-deep}" },
      "border": { "$value": "{semantic.color.success-border}" }
    },
    "progress": {
      "track": { "$value": "{primitive.color.slate.100}" },
      "fill": { "$value": "{semantic.color.success}" }
    },
    "skeleton": {
      "base": { "$value": "{primitive.color.slate.200}" }
    },
    "input": {
      "focus-border": { "$value": "{semantic.color.primary}" }
    }
  }
}
